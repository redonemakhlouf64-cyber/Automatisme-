{
  "name": "nyx-social-automation",
  "version": "0.1.0",
  "private": true,
  "description": "Nyx Social Automation Platform",
  "workspaces": [
    "apps/*",
    "packages/*",
    "integrations/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@nyx/dashboard",
    "dev:api": "npm run dev --workspace=@nyx/api",
    "dev:worker": "npm run dev --workspace=@nyx/worker",
    "build": "npm run build --workspaces",
    "test": "npm run test --workspaces"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.4",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.11"
  }
}
